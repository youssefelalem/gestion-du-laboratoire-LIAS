<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Laboratoire LIAS - Application JEE Classique</display-name>

    <description>
        Système de gestion du laboratoire LIAS - Faculté des Sciences Ben M'Sik
        Architecture MVC 2 classique : JavaBeans + DAO (JDBC) + Servlets + Vues JSP.
    </description>

    <!-- 1. Servlet Accueil Public -->
    <servlet>
        <servlet-name>PublicServlet</servlet-name>
        <servlet-class>com.lias.web.PublicServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublicServlet</servlet-name>
        <url-pattern>/public</url-pattern>
        <url-pattern>/accueil</url-pattern>
    </servlet-mapping>

    <!-- 2. Servlet Authentification (Login) -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.lias.web.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 3. Servlet Déconnexion (Logout) -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.lias.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 4. Servlet Espace Privé Dashboard -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.lias.web.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- 5. Servlet Membres et Profils (CDC §3) -->
    <servlet>
        <servlet-name>MemberServlet</servlet-name>
        <servlet-class>com.lias.web.MemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemberServlet</servlet-name>
        <url-pattern>/membres</url-pattern>
        <url-pattern>/profils</url-pattern>
    </servlet-mapping>

    <!-- 6. Servlet Publications Scientifiques (CDC §12) -->
    <servlet>
        <servlet-name>PublicationServlet</servlet-name>
        <servlet-class>com.lias.web.PublicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublicationServlet</servlet-name>
        <url-pattern>/publications</url-pattern>
    </servlet-mapping>

    <!-- 7. Servlet Évènements et Calendrier (CDC §9) -->
    <servlet>
        <servlet-name>EvenementServlet</servlet-name>
        <servlet-class>com.lias.web.EvenementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvenementServlet</servlet-name>
        <url-pattern>/evenements</url-pattern>
        <url-pattern>/calendrier</url-pattern>
    </servlet-mapping>

    <!-- 8. Servlet Demandes d'Adhésion (CDC §6) -->
    <servlet>
        <servlet-name>AdhesionServlet</servlet-name>
        <servlet-class>com.lias.web.AdhesionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdhesionServlet</servlet-name>
        <url-pattern>/adhesions</url-pattern>
    </servlet-mapping>

    <!-- 9. Servlet Gestion du Matériel (CDC §14) -->
    <servlet>
        <servlet-name>MaterielServlet</servlet-name>
        <servlet-class>com.lias.web.MaterielServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MaterielServlet</servlet-name>
        <url-pattern>/materiel</url-pattern>
    </servlet-mapping>

    <!-- 10. Servlet Rapport Annuel (CDC §11) -->
    <servlet>
        <servlet-name>RapportServlet</servlet-name>
        <servlet-class>com.lias.web.RapportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RapportServlet</servlet-name>
        <url-pattern>/rapport</url-pattern>
    </servlet-mapping>

    <!-- Filtre de sécurité JEE pour interdire l'accès direct sans session -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.lias.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/home</url-pattern>
        <url-pattern>/rapport</url-pattern>
    </filter-mapping>

    <!-- Page d'accueil par défaut -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Timeout (30 min) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
